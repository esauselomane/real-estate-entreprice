{
  "dashboard": {
    "title": "Real Estate Platform - Service Health",
    "uid": "real-estate-health",
    "timezone": "browser",
    "refresh": "15s",
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Identity Service",
        "type": "stat",
        "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
        "targets": [
          {
            "expr": "up{job=\"identity\"}",
            "legendFormat": "Identity",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              { "type": "value", "value": "0", "displayText": "Down", "color": "red" },
              { "type": "value", "value": "1", "displayText": "Up", "color": "green" }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "red" },
                { "value": 1, "color": "green" }
              ]
            }
          }
        }
      },
