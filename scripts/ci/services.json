    "client-facing": {
      "frontend": "client-facing-app",
      "folders": [
        "client-facing-app/"
      ],
      "dockerfile": "client-facing-app/Dockerfile",
      "files": [
        ".dockerignore"
      ],
      "health_path": "/api/health",
      "build_args": {
        "NEXT_PUBLIC_GATEWAY_URL": "https://api.biscovetech.com",
        "NEXT_PUBLIC_APP_URL": "https://app.biscovetech.com",
        "NEXT_PUBLIC_SITE_URL": "https://www.biscovetech.com",
        "NEXT_PUBLIC_LAND_APP_URL": "https://landadmin.biscovetech.com"
      }
    }
