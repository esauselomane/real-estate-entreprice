PORT=3010
PUBLIC_SITE_ORIGIN=http://localhost:3010
# Root of Developer.API, including its public route prefix. Never use VITE_ or NEXT_PUBLIC_ for the key.
DEVELOPER_API_URL=http://localhost:5006/api/developer/
# The tenant/agency ID must match the agency that issued the key.
AGENCY_ID=
AGENCY_API_KEY=
AGENCY_DISPLAY_NAME=Biscove Properties
# Set this for live hosting; secure cookies require HTTPS.
NODE_ENV=development

# Public browser key, restricted to website referrers and Maps/Places APIs.
GOOGLE_MAPS_BROWSER_KEY=
# Public production origin is used for canonical URLs and sitemaps.
# PUBLIC_SITE_ORIGIN=https://properties.example.com
# Optional absolute HTTPS social-sharing image (prefer 1200 x 630).
SEO_SOCIAL_IMAGE=
# Keep aligned with listing prices and the site currency display.
SITE_CURRENCY=ZAR
# Optional verification values supplied by Google Search Console / Bing Webmaster Tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Public branding URLs: a bundled asset path or an absolute HTTPS URL.
PUBLIC_LOGO_URL=/logo.jpg
PUBLIC_FAVICON_URL=/favicon.svg

# Server-only property assistant. Never prefix this key with PUBLIC_, VITE_ or NEXT_PUBLIC_.
# Leave empty to hide the assistant while retaining normal property browsing.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
